{
  "name": "campus-timetable",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "data:build": "python3 tools/parse_timetables.py --input raw --output public/data",
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "deploy": "pnpm build && wrangler pages deploy dist --project-name campus-timetable",
    "preview": "vite preview"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.8",
    "lucide-vue-next": "^0.468.0",
    "reka-ui": "^2.5.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vue-tsc": "^2.2.0",
    "wrangler": "4.126.0"
  }
}
